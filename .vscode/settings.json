{
    "wro2026.pathPlanner.scriptPath": "${workspaceFolder}/tools/path_planner/build_routes.py",
    "wro2026.editor.scriptPath": "${workspaceFolder}/tools/path_planner/edit_field.py",
    "wro2026.sim.scriptPath": "${workspaceFolder}/tools/path_planner/sim/demo.py",
    "wro2026.sim.goals": "Start, finial",
    // arduino-cli resolved from PATH (standalone ArduinoSA.CLI). Without the standalone CLI, point this at the IDE-bundled binary: macOS "~/Applications/Arduino IDE.app/Contents/Resources/app/lib/backend/resources/arduino-cli"; Windows "C:/Users/<you>/AppData/Local/Programs/Arduino IDE/resources/app/lib/backend/resources/arduino-cli.exe".
    "wro2026.arduino.cliPath": "arduino-cli",
    "wro2026.arduino.fqbn": "arduino:renesas_uno:unor4wifi",
    "wro2026.arduino.sketchPath": "WRO2026",
    "wro2026.arduino.port": "auto",
    "wro2026.arduino.baudRate": "115200",
    "python.testing.pytestArgs": [
        "."
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "cmake.sourceDirectory": "${workspaceFolder}/WRO2026/test",
    "cmake.ctest.neverDebugTestsWithLaunchConfiguration": false
}
