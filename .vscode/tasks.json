{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "osx": {
        "options": {
            "shell": {
                "executable": "${env:SHELL}",
                "args": [
                    "-lc"
                ]
            }
        }
    },
    "linux": {
        "options": {
            "shell": {
                "executable": "${env:SHELL}",
                "args": [
                    "-lc"
                ]
            }
        }
    },
    "tasks": [
        {
            "label": "Path Planner: Build Routes",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "${config:wro2026.pathPlanner.scriptPath}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Editor: Open Field Editor GUI",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "${config:wro2026.editor.scriptPath}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Sim: Run PathTracker Demo",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "${config:wro2026.sim.scriptPath}",
                "--goals",
                "${config:wro2026.sim.goals}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Sim: Plot PathTracker Demo",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "${config:wro2026.sim.scriptPath}",
                "--goals",
                "${config:wro2026.sim.goals}",
                "--plot"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Arduino: Verify WRO2026",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "${workspaceFolder}/tools/arduino_cli_task.py",
                "verify",
                "--cli",
                "${config:wro2026.arduino.cliPath}",
                "--fqbn",
                "${config:wro2026.arduino.fqbn}",
                "--sketch",
                "${config:wro2026.arduino.sketchPath}"
            ],
            "dependsOn": "Path Planner: Build Routes",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Arduino: Upload WRO2026",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "${workspaceFolder}/tools/arduino_cli_task.py",
                "upload",
                "--cli",
                "${config:wro2026.arduino.cliPath}",
                "--fqbn",
                "${config:wro2026.arduino.fqbn}",
                "--sketch",
                "${config:wro2026.arduino.sketchPath}",
                "--port",
                "${config:wro2026.arduino.port}"
            ],
            "dependsOn": "Arduino: Verify WRO2026",
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Arduino: List Boards",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "${workspaceFolder}/tools/arduino_cli_task.py",
                "list-boards",
                "--cli",
                "${config:wro2026.arduino.cliPath}",
                "--fqbn",
                "${config:wro2026.arduino.fqbn}",
                "--sketch",
                "${config:wro2026.arduino.sketchPath}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Arduino: Monitor Serial",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "${workspaceFolder}/tools/arduino_cli_task.py",
                "monitor",
                "--cli",
                "${config:wro2026.arduino.cliPath}",
                "--fqbn",
                "${config:wro2026.arduino.fqbn}",
                "--sketch",
                "${config:wro2026.arduino.sketchPath}",
                "--port",
                "${config:wro2026.arduino.port}",
                "--baud",
                "${config:wro2026.arduino.baudRate}"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "CTPS: build & view",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "-m",
                "tools.path_planner.ctps"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
